# Configuration du service Alfred. Les valeurs sont lues comme un fichier Bash.
HOME_ASSISTANT_URL="http://homeassistant.local:8123"
HOME_ASSISTANT_TOKEN_FILE=""
ALFRED_DEVICE=""
ALFRED_MODELS_DIR=""
ALFRED_REQUIRE_ALFRED="true"
ALFRED_QUIET="true"
ALFRED_EXECUTE_HOME_ASSISTANT="true"
ALFRED_SPECIALIZATION="true"
ALFRED_INTENT_MODE="flat"
ALFRED_LAYA_BACKEND="auto"
ALFRED_DUPLICATE_WINDOW="3"
ALFRED_THRESHOLD=""
